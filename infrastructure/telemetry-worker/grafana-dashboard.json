          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"sql\":\"SELECT 'Sleep schedule' AS feature, COALESCE(SUM(sleep_enabled),0) AS installs FROM beacons UNION ALL SELECT 'Weather alerts', COALESCE(SUM(alerts_enabled),0) FROM beacons UNION ALL SELECT 'Authentication', COALESCE(SUM(auth_enabled),0) FROM beacons UNION ALL SELECT 'Google Calendar', COALESCE(SUM(has_google_calendar),0) FROM beacons UNION ALL SELECT 'iCal sources', COALESCE(SUM(has_ical_sources),0) FROM beacons UNION ALL SELECT 'Plugins', COALESCE(SUM(CASE WHEN plugin_count > 0 THEN 1 ELSE 0 END),0) FROM beacons UNION ALL SELECT 'Multi-display', COALESCE(SUM(CASE WHEN display_count > 0 THEN 1 ELSE 0 END),0) FROM beacons ORDER BY installs DESC\"}"
          },
          "root_selector": "result[0].results",
          "columns": [
