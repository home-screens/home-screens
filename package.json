{
  "name": "home-screens",
  "version": "1.12.0-rc.3",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=11.6.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=3072' next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:shell": "bash scripts/__tests__/reporter.test.sh && bash scripts/__tests__/kiosk-update.test.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docs:shots": "tsx website/scripts/capture-docs-shots.mts",
    "config:check": "node scripts/check-config.mjs",
    "fa:copy": "node scripts/copy-font-awesome.mjs",
    "postinstall": "node scripts/copy-font-awesome.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "entities": "^8.0.0",
    "fast-xml-parser": "^5.11.1",
    "framer-motion": "^12.35.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.11",
    "node-ical": "^0.25.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "suncalc": "^1.9.0",
    "tsdav": "^2.3.1",
    "uuid": "^14.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "^7.0.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/suncalc": "^1.9.2",
    "@vitest/coverage-v8": "^4.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.18"
  }
}
