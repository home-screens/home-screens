# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.c*
!.claude/
.claude/*
!.claude/commands/
tailwind/*
mockups/*
plans/*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# runtime data (deny-all, allow tracked files)
data/*
!data/secrets.example.json

# user-uploaded backgrounds
public/backgrounds/*
!public/backgrounds/default.svg
!public/backgrounds/themes/

# cloudflare worker
infrastructure/telemetry-worker/node_modules
infrastructure/telemetry-worker/.wrangler

# emulate-install VM artifacts
.emulate/

# git worktrees
.worktrees/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Font Awesome assets — regenerated on `npm install` by scripts/copy-font-awesome.mjs
/public/font-awesome/

# Bundled config-check CLI — generated by release.yml / deploy.sh, never committed
scripts/check-config.cjs
